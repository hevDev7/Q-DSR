# ---------------------------------------------------------------------------
# Q-DSR Protocol — environment
#
# Every variable here is OPTIONAL. With none of them set the API server runs on
# an on-disk JSON store, seals evidence to a local content-addressed cache, and
# reports plainly that the chain is not connected. The verification workflow is
# fully exercisable in that mode; what you lose is publication, not function.
# ---------------------------------------------------------------------------

# --- API server -------------------------------------------------------------
PORT=8080
# Where the JSON store and the evidence cache live.
QDSR_DATA_DIR=.data

# --- Persistence ------------------------------------------------------------
# Set to use Postgres instead of the on-disk JSON store.
# Run `pnpm --filter @workspace/db run push` once to create the tables.
# DATABASE_URL=postgresql://user:password@host:5432/qdsr

# --- 0G Chain ---------------------------------------------------------------
# All three are required before verdicts can be anchored on chain.
# Mainnet:  chain id 16661, https://evmrpc.0g.ai,         https://chainscan.0g.ai
# Galileo:  chain id 16602, https://evmrpc-testnet.0g.ai, https://chainscan-galileo.0g.ai
# OG_RPC_URL=https://evmrpc.0g.ai
# OG_CHAIN_ID=16661
# OG_PRIVATE_KEY=0x...
# QDSR_REGISTRY_ADDRESS=0x...
# AGENTIC_ID_ADDRESS=0x...

# --- 0G Storage -------------------------------------------------------------
# Without these, evidence is sealed under its real 0G merkle root but kept
# locally rather than published. The root is identical either way.
# OG_STORAGE_INDEXER_RPC=https://indexer-storage-turbo.0g.ai
# OG_STORAGE_EVM_RPC=https://evmrpc.0g.ai
# OG_STORAGE_PRIVATE_KEY=0x...

# --- Engine defaults --------------------------------------------------------
# QDSR_BOOTSTRAP_ITERATIONS=10000
# QDSR_CSCV_SPLITS=16
# QDSR_DEFAULT_SEED=20260820

# --- Contract deployment (contracts/) ---------------------------------------
# Only needed when running `pnpm --filter @workspace/contracts run deploy:*`.
# DEPLOYER_PRIVATE_KEY=0x...
# ATTESTOR_ADDRESS=0x...

# --- Frontend dev -----------------------------------------------------------
# The vite dev server proxies /api to this target.
# API_PROXY_TARGET=http://127.0.0.1:8080
